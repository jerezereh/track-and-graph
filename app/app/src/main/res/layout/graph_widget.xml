<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp"
    android:background="@drawable/graph_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/graph_widget_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/graph_widget_name" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/graph_widget_text" android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@+id/graph_widget_add"
            android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:text="＋" android:textSize="24sp" android:visibility="gone"
            android:textColor="@color/graph_widget_text" android:background="@android:color/transparent"
            android:contentDescription="@string/graph_widget_add" />
        <Button android:id="@+id/graph_widget_settings"
            android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:text="⚙" android:textSize="22sp"
            android:textColor="@color/graph_widget_text" android:background="@android:color/transparent"
            android:contentDescription="@string/graph_widget_configure" />
    </LinearLayout>
    <ImageView android:id="@+id/graph_widget_image"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitCenter" android:visibility="gone"
        android:contentDescription="@string/graph_widget_name" />
    <TextView android:id="@+id/graph_widget_message"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="@string/graph_widget_loading"
        android:textColor="@color/graph_widget_text" android:textSize="13sp" />
</LinearLayout>
